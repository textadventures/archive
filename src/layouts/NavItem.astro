---
const { href, text, current } = Astro.props;

// build.format "file" keeps a .html suffix on Astro.url.pathname for
// statically-generated pages, so it needs stripping before comparison.
const normalized = current.replace(/\.html$/, "").replace(/\/$/, "") + "/";

let isCurrent = false;

if (href === "/") {
    isCurrent = normalized === "/";
} else {
    isCurrent = normalized.startsWith(href);
}

---
<li class="nav-item">
    <a class={`nav-link ${isCurrent ? "active" : ""}`}
        aria-current={isCurrent ? "page" : undefined}
        href={href}>{text}</a>
</li>
