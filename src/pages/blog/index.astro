---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Search from "astro-pagefind/components/Search.astro";

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

---

<Layout title="Blog">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/">Archive</a></li>
          <li class="breadcrumb-item active" aria-current="page">Blog</li>
        </ol>
    </nav>

    <h2>Blog</h2>

    <Search id="search" className="pagefind-ui mb-3" uiOptions={{ showImages: false }} />

    <ul>
        {posts.map((post) => (
            <li>
                <a href={`/blog/${post.id}`}>{post.data.title}</a> - <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })}</time>{post.data.author && <> by {post.data.author}</>}
            </li>
        ))}
    </ul>
</Layout>
